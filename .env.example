# TinyMUSH Docker environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Required ─────────────────────────────────────────────────────────────────

# Secret used to sign session cookies.
# Generate with: openssl rand -hex 64
SESSION_SECRET=change_me_to_a_long_random_string_generated_with_openssl_rand_hex_64

# ── TLS / Caddy (production only) ────────────────────────────────────────────

# Public domain name that Caddy will obtain a Let's Encrypt certificate for.
CADDY_DOMAIN=mush.example.com

# Email address for Let's Encrypt ACME account notifications.
CADDY_EMAIL=admin@example.com
