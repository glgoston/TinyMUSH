# ─── Stage 1: Build ────────────────────────────────────────────────────────────
FROM debian:trixie AS builder

ARG BUILD_TYPE=Release

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ca-certificates \
    liblmdb-dev libpcre2-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -B build \
      -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
      -DCMAKE_INSTALL_PREFIX=/game \
      -DUSE_LMDB=ON \
      -DUSE_GDBM=OFF \
      -DTINYMUSH_USE_CCACHE=OFF \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build

# ─── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM debian:trixie AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    liblmdb0 libpcre2-8-0 libcrypt1 netcat-openbsd xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for the game process
RUN groupadd --gid 1000 mush \
 && useradd --uid 1000 --gid mush --no-create-home --shell /bin/sh mush

# Copy installed game tree and entrypoint
COPY --from=builder /game /game
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
 && chown -R mush:mush /game

# Port 6250 is declared here but intentionally NOT published to the host in
# docker-compose.yml — it is only reachable from the internal bridge network.
EXPOSE 6250

# Persistent game data lives in named volumes
VOLUME ["/game/db", "/game/logs", "/game/backups"]

WORKDIR /game
USER mush

ENTRYPOINT ["/entrypoint.sh"]
